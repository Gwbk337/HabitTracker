@{
    ViewData["Title"] = "Главная";
}


<div class="container">


    <div class="row align-items-center mt-5">


        <div class="col-md-7">


            <h1 class="display-4 fw-bold">

                🚀 HabitTracker

            </h1>


            <h2 class="mt-3">

                Создавай привычки.
                Меняй свою жизнь.

            </h2>



            <p class="lead mt-4">

                Удобный онлайн-трекер привычек.
                Отслеживай прогресс, развивай дисциплину
                и достигай целей каждый день.

            </p>




            @if (User.Identity != null &&
               User.Identity.IsAuthenticated)
            {

                <a class="btn btn-primary btn-lg mt-3"
                   href="/Habit">

                    📋 Мои привычки

                </a>

            }
            else
            {

                <a class="btn btn-primary btn-lg mt-3"
                   href="/Account/Register">

                    Начать бесплатно 🚀

                </a>

            }


        </div>




        <div class="col-md-5">


            <div class="card shadow p-4 text-center">


                <h1>
                    🔥
                </h1>


                <h3>

                    Стань лучше каждый день

                </h3>


                <p>

                    Отмечай выполнение.
                    Следи за сериями.
                    Получай результат.

                </p>


            </div>


        </div>


    </div>





    <hr class="my-5">





    <h2 class="text-center mb-4">

        Почему HabitTracker?

    </h2>




    <div class="row">



        <div class="col-md-4">


            <div class="card shadow p-4">


                <h3>
                    📅
                </h3>


                <h4>
                    Контроль привычек
                </h4>


                <p>

                    Создавай свои цели
                    и выполняй их каждый день.

                </p>


            </div>


        </div>






        <div class="col-md-4">


            <div class="card shadow p-4">


                <h3>
                    📊
                </h3>


                <h4>
                    Статистика
                </h4>


                <p>

                    Следи за прогрессом,
                    сериями и результатами.

                </p>


            </div>


        </div>







        <div class="col-md-4">


            <div class="card shadow p-4">


                <h3>
                    💎
                </h3>


                <h4>
                    Premium
                </h4>


                <p>

                    Больше возможностей
                    для серьезных целей.

                </p>


            </div>


        </div>


    </div>





    <div class="text-center mt-5">


        <h2>

            Готов начать?

        </h2>


        <p>

            Регистрация занимает меньше минуты.

        </p>



        <a class="btn btn-success btn-lg"
           href="/Account/Register">

            Создать аккаунт

        </a>


    </div>


</div>